# Contact form – email delivery
# Copy this file to .env and fill in your values. Never commit .env.

# Where to receive contact form submissions (defaults to site email if not set)
CONTACT_EMAIL_TO=aadityakum123@gmail.com

# SMTP (e.g. Gmail). For Gmail: use App Password, not your normal password.
# Create App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aadityakum123@gmail.com
SMTP_PASS=zdvxspzgtoynvomk 

# Optional: "From" name and address (defaults to SMTP_USER)
# SMTP_FROM="Suja Waterproofing <sujawps@gmail.com>"

# Optional: use secure port 465 (set to true if SMTP_PORT=465)
# SMTP_SECURE=false
